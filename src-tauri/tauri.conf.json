{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "carve",
  "version": "0.1.0",
  "identifier": "com.carve.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GIF Recorder - Studio",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "selector",
        "title": "GIF Recorder - Area Selector",
        "transparent": true,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "GIF Recorder - Live Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
